###############################################################################
# kyverno-java-truststore-policy.yaml
#
# Kyverno ClusterPolicy that injects the custom truststore (standard CAs +
# BNP CAs) into ALL containers of ALL pods in the Apigee namespace.
#
# - Java containers: JKS truststore at the default Java cacerts path
# - Go/other containers: PEM bundle at /etc/ssl/certs/ca-certificates.crt
#
# This avoids modifying the Apigee Helm charts entirely.
###############################################################################
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: inject-truststore
  annotations:
    policies.kyverno.io/description: >-
      Mounts custom truststores (JKS + PEM) into all pods in the Apigee
      namespace. Fixes PKIX/TLS failures caused by BNP proxy TLS interception.
spec:
  rules:
    - name: inject-truststore
      match:
        any:
          - resources:
              kinds:
                - Pod
              namespaces:
                - apigee-ap88257-hprd-dce13121
      mutate:
        patchStrategicMerge:
          spec:
            volumes:
              - name: bnpp-java-truststore
                configMap:
                  name: bnpp-java-truststore
              - name: -ca-bundle
                configMap:
                  name: -ca-bundle-full
        foreach:
          - list: "request.object.spec.containers"
            patchStrategicMerge:
              spec:
                containers:
                  - name: "{{ element.name }}"
                    volumeMounts:
                      - name: -java-truststore
                        mountPath: /usr/lib/jvm/temurin-17-jre-amd64/lib/security/cacerts
                        subPath: cacerts
                        readOnly: true
                      - name: -ca-bundle
                        mountPath: /etc/ssl/certs/ca-certificates.crt
                        subPath: ca-certificates.crt
                        readOnly: true
