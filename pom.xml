# 1. Quel truststore Java existe ?
find / -name "cacerts" 2>/dev/null

# 2. Lister les CAs dans le truststore Java
keytool -list -keystore /etc/ssl/certs/java/cacerts -storepass changeit 2>/dev/null | tail -20

# 3. Y a-t-il la CA  dedans ?
keytool -list -keystore /etc/ssl/certs/java/cacerts -storepass changeit 2>/dev/null | grep -i 

# 4. Combien de certs dans le PEM monté ?
grep -c "BEGIN CERTIFICATE" /etc/ssl/certs/ca-certificates.crt

# 5. Le script d'entrypoint importe-t-il le PEM dans le JKS ?
cat /entrypoint.sh 2>/dev/null || cat /opt/apigee/run.sh 2>/dev/null
