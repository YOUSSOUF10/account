
#!/bin/bash
###############################################################################
# build-java-truststore.sh
#
# Creates a ConfigMap "covi-java-truststore" containing a JKS truststore
# with all standard Java CAs + all BNP CAs from the PEM bundle.
#
# Run this from a machine with kubectl access to the cluster.
###############################################################################
set -euo pipefail

NS="apigee-ap88257-hprd-dce13121"
IMAGE="private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-mart-server:1.17.0"
POD_NAME="truststore-builder"
CONFIGMAP_NAME="covi-java-truststore"
JAVA_CACERTS="/usr/lib/jvm/temurin-17-jre-amd64/lib/security/cacerts"

echo "=== Step 1: Creating builder pod with CA bundle mounted ==="
kubectl run "$POD_NAME" --image="$IMAGE" -n "$NS" \
  --restart=Never \
  --overrides='{
    "spec": {
      "containers": [{
        "name": "'"$POD_NAME"'",
        "image": "'"$IMAGE"'",
        "command": ["sleep", "600"],
        "volumeMounts": [{
          "name": "ca-bundle",
          "mountPath": "/etc/ssl/certs/ca-certificates.crt",
          "subPath": "ca-certificates.crt",
          "readOnly": true
        }]
      }],
      "volumes": [{
        "name": "ca-bundle",
        "configMap": {
          "name": "covi-ca-bundle-full"
        }
      }]
    }
  }' -- sleep 600

echo "Waiting for pod to be ready..."
kubectl wait --for=condition=Ready "pod/$POD_NAME" -n "$NS" --timeout=120s

echo ""
echo "=== Step 2: Writing build script ==="
INNER_SCRIPT=$(mktemp /tmp/inner-build-XXXXXX.sh)
cat > "$INNER_SCRIPT" << 'INNER_EOF'
#!/bin/sh
set -e

JAVA_CACERTS="/usr/lib/jvm/temurin-17-jre-amd64/lib/security/cacerts"
PEM_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
CUSTOM_CACERTS="/tmp/custom-cacerts"

echo "Copying default Java truststore..."
cp "$JAVA_CACERTS" "$CUSTOM_CACERTS"

echo "Default truststore entries:"
keytool -list -keystore "$CUSTOM_CACERTS" -storepass changeit 2>/dev/null | grep -c "trustedCertEntry"

echo ""
echo "Splitting PEM bundle into individual certificates..."
cd /tmp
rm -f /tmp/covi-cert-*

n=0
fname=""
while IFS= read -r certline; do
  case "$certline" in
    "-----BEGIN CERTIFICATE-----")
      n=`expr $n + 1`
      fname="/tmp/covi-cert-$n.pem"
      ;;
  esac
  if [ "$n" -gt 0 ] && [ -n "$fname" ]; then
    echo "$certline" >> "$fname"
  fi
done < "$PEM_BUNDLE"

total=`ls /tmp/covi-cert-*.pem 2>/dev/null | wc -l`
echo "Found $total certificates in the PEM bundle"

echo ""
echo "Importing certificates into custom truststore..."
imported=0
skipped=0
for cert in /tmp/covi-cert-*.pem; do
  alias_name="covi-ca-`basename "$cert" .pem`"
  if keytool -import -noprompt -alias "$alias_name" -trustcacerts \
    -file "$cert" \
    -keystore "$CUSTOM_CACERTS" \
    -storepass changeit 2>/dev/null; then
    imported=`expr $imported + 1`
  else
    skipped=`expr $skipped + 1`
  fi
done

echo ""
echo "Imported: $imported new certificates"
echo "Skipped [duplicates]: $skipped"
echo ""
echo "Final truststore entries:"
keytool -list -keystore "$CUSTOM_CACERTS" -storepass changeit 2>/dev/null | grep -c "trustedCertEntry"
INNER_EOF

echo "=== Step 2b: Copying build script into pod ==="
kubectl cp "$INNER_SCRIPT" "$NS/$POD_NAME:/tmp/build.sh"
rm -f "$INNER_SCRIPT"

echo "=== Step 2c: Building custom truststore inside the pod ==="
kubectl exec "$POD_NAME" -n "$NS" -- sh /tmp/build.sh

echo ""
echo "=== Step 3: Extracting truststore from pod ==="
kubectl cp "$NS/$POD_NAME:/tmp/custom-cacerts" /tmp/custom-cacerts

echo ""
echo "=== Step 4: Creating/updating ConfigMap ==="
kubectl create configmap "$CONFIGMAP_NAME" \
  --from-file=cacerts=/tmp/custom-cacerts \
  -n "$NS" \
  --dry-run=client -o yaml | kubectl apply -f -

echo ""
echo "=== Step 5: Cleanup ==="
kubectl delete pod "$POD_NAME" -n "$NS" --force --grace-period=0
rm -f /tmp/custom-cacerts

echo ""
echo "=== Done! ==="
echo "ConfigMap '$CONFIGMAP_NAME' created in namespace '$NS'"
echo ""
echo "Verify with:"
echo "  kubectl get configmap $CONFIGMAP_NAME -n $NS"
echo "  kubectl get configmap $CONFIGMAP_NAME -n $NS -o jsonpath='{.data.cacerts}' | wc -c"
