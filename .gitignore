    {{- toYaml . | nindent 4 }}
  {{- end }}
  {{- $ns := merge (dict) (default dict .Values.guardrails.nodeSelector) .Values.nodeSelector }}
  {{- if $ns }}
  affinity:
    {{- include "nodeAffinity.runtime" $ns | nindent 4 }}
  {{- end }}
  {{- $t := default .Values.tolerations .Values.guardrails.tolerations }}
  {{- with $t }}
  tolerations:
    {{- toYaml $t | nindent 4 }}
  {{- end }}
  securityContext:
    runAsNonRoot: true
    runAsUser: {{ .Values.apigeeUserID }}
    runAsGroup: {{ .Values.apigeeGroupID }}
    {{- if ne $seccompProfileType "" }}
    seccompProfile:
      type: {{ $seccompProfileType }}
      {{- if ne $localhostProfile "" }}
      localhostProfile: {{ $localhostProfile }}
      {{- end }}
    {{- end }}
  containers:
    - name: apigee-hybrid-helm-guardrail-container
      image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.guardrails "n" "apigee-watcher") }}
      imagePullPolicy: {{ .Values.guardrails.image.pullPolicy }}
      command: ['/helmguardrails']
      env:
      - name: COMPONENT
        value: "org"
      - name: CHECKPOINT
      {{- if .Values.checkpoint }}
        value: {{ .Values.checkpoint }}
      {{- else }}
        value: "pre-install"
      {{- end }}
      - name: APIGEE_ENDPOINT
        value: {{ .Values.contractProvider}}
      {{- if $httpProxyURL }}
      - name: http_proxy
        value: {{ $httpProxyURL }}
      - name: https_proxy
        value: {{ $httpProxyURL }}
      {{- end }}
      {{- if .Values.guardrails.envVars }}
      {{- range $key, $value := .Values.guardrails.envVars }}
      {{- if not (and $httpProxyURL (or (eq (upper $key) "HTTP_PROXY") (eq (upper $key) "HTTPS_PROXY"))) }}
      - name: {{ $key }}
        value: {{ $value | quote }}
      {{- end }}
      {{- end }}
      {{- end }}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
          - ALL
      {{- with .Values.guardrails.resources }}
      resources:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      volumeMounts:
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ .Values.customCA.configMapKey }}
          readOnly: true
      {{- end }}
  {{- if (.Values.customCA).enabled }}
  volumes:
    - name: custom-ca
      configMap:
        name: {{ .Values.customCA.configMapName }}
        defaultMode: 420
  {{- end }}
  restartPolicy: Never
  terminationGracePeriodSeconds: 0


{{- template "helmVersionCheck" . }}
{{- template "gcpProjectIDCheck" . }}
{{- $datastoreName := "default" -}}
{{- $apigeeRedisName := "default" -}}
{{- $martName := "apigee-mart" -}}
{{- $connectAgentName := "apigee-connect-agent" -}}
{{- $mintTaskScheduler := "apigee-mint-task-scheduler" -}}
{{- $watcherName := "apigee-watcher" -}}
{{- $mcpServerName := "apigee-mcp-server" -}}
{{- $schemaReadinessName := "apigee-cassandra-schema-readiness" -}}
{{- $cassandraReadinessName := "apigee-cassandra-readiness" -}}
{{- $cassandraUserSetupName := "apigee-cassandra-user-setup" -}}
{{- $cassandraUserReadinessName := "apigee-cassandra-user-readiness" -}}
{{- $cassandraSchemaSetupName := "apigee-cassandra-schema-setup" -}}
{{- $cassandraSchemaValidationName := "apigee-cassandra-schema-val" -}}
{{- $wiAnnotation := "apigee.cloud.google.com/wi-config-checksum" -}}
{{- $saAnnotation := "apigee.cloud.google.com/sa-config-checksum" -}}
{{- $generatedName := include "orgScopeEncodedName" (dict "name" .Values.org) -}}
{{- $generatedIngressChainingName := printf "%s-%s-%s" "apigee-ingressgateway" .Values.apigeeChainingGateway.name $generatedName -}}
{{- $cassandraUserSetupSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.cassandraUserSetup "values" .Values) | fromYaml -}}
{{- $cassandraUserSetupSeccompProfileType := $cassandraUserSetupSeccompProfileInfo.type -}}
{{- $cassandraUserSetupLocalhostProfile := $cassandraUserSetupSeccompProfileInfo.localhostProfile -}}
{{- $cassandraSchemaSetupSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.cassandraSchemaSetup "values" .Values) | fromYaml -}}
{{- $cassandraSchemaSetupSeccompProfileType := $cassandraSchemaSetupSeccompProfileInfo.type -}}
{{- $cassandraSchemaSetupLocalhostProfile := $cassandraSchemaSetupSeccompProfileInfo.localhostProfile -}}
{{- $connectAgentSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.connectAgent "values" .Values) | fromYaml -}}
{{- $connectAgentSeccompProfileType := $connectAgentSeccompProfileInfo.type -}}
{{- $connectAgentLocalhostProfile := $connectAgentSeccompProfileInfo.localhostProfile -}}
{{- $cassandraSchemaValidationSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.cassandraSchemaValidation "values" .Values) | fromYaml -}}
{{- $cassandraSchemaValidationSeccompProfileType := $cassandraSchemaValidationSeccompProfileInfo.type -}}
{{- $cassandraSchemaValidationLocalhostProfile := $cassandraSchemaValidationSeccompProfileInfo.localhostProfile -}}
{{- $martSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.mart "values" .Values) | fromYaml -}}
{{- $martSeccompProfileType := $martSeccompProfileInfo.type -}}
{{- $martLocalhostProfile := $martSeccompProfileInfo.localhostProfile -}}
{{- $watcherSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.watcher "values" .Values) | fromYaml -}}
{{- $watcherSeccompProfileType := $watcherSeccompProfileInfo.type -}}
{{- $watcherLocalhostProfile := $watcherSeccompProfileInfo.localhostProfile -}}
{{- $mintSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.mintTaskScheduler "values" .Values) | fromYaml -}}
{{- $mintSeccompProfileType := $mintSeccompProfileInfo.type -}}
{{- $mintLocalhostProfile := $mintSeccompProfileInfo.localhostProfile -}}
{{- $apigeeIngressGatewaySeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.apigeeIngressGateway "values" .Values) | fromYaml -}}
{{- $apigeeIngressGatewaySeccompProfileType := $apigeeIngressGatewaySeccompProfileInfo.type -}}
{{- $apigeeIngressGatewayLocalhostProfile := $apigeeIngressGatewaySeccompProfileInfo.localhostProfile -}}
{{- $mcpServerSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.mcpServer "values" .Values) | fromYaml -}}
{{- $mcpServerSeccompProfileType := $mcpServerSeccompProfileInfo.type -}}
{{- $mcpServerLocalhostProfile := $mcpServerSeccompProfileInfo.localhostProfile -}}
apiVersion: apigee.cloud.google.com/v1alpha2
kind: ApigeeOrganization
metadata:
  name: "{{ $generatedName }}"
  namespace: {{ include "namespace" . }}
  labels:
    apigee.cloud.google.com/platform: apigee
release:
  forceUpdate: true
spec:
  {{- with .Values.imagePullSecrets }}
  imagePullSecrets:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  name: {{ quote .Values.org }}
  datastoreRef: "{{ $datastoreName }}"
  {{- if .Values.encryptionKeySecretProviderClass }}
  dataEncryptionSecretProviderClass: {{ .Values.encryptionKeySecretProviderClass }}
  {{- end }}
  dataEncryptionRef: "{{ $generatedName }}-data-encryption"
  redisRef: "{{ $apigeeRedisName }}"
  {{- if .Values.axHashSaltSecretProviderClass }}
  axHashingSaltSecretProviderClass: "{{ .Values.axHashSaltSecretProviderClass }}"
  {{- else if .Values.axHashSaltSecret }}
  axHashingSaltRef: "{{ .Values.axHashSaltSecret }}"
  {{- else }}
  axHashingSaltRef: "{{ $generatedName }}-ax-salt"
  {{- end }}
  apigeeEndpoint: "{{ .Values.contractProvider}}"
  apigeeConnectEndpoint: "{{ .Values.connectAgent.server }}"
  instanceID: {{ include "validateInstanceID" (dict "s" (required "instanceID is required" .Values.instanceID)) | quote }}
  version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
  clusterName: "{{ .Values.k8sCluster.name }}"
  clusterRegion: "{{ .Values.k8sCluster.region }}"
  gcpProjectID: "{{ .Values.gcp.projectID }}"
  {{- if .Values.enhanceProxyLimits }}
  proxyChainingAddress: {{ printf "%s.%s.%s" $generatedIngressChainingName (include "namespace" .) "svc.cluster.local" }}
  {{- end }}
  {{- if .Values.httpProxy }}
  httpForwardProxy:
    scheme: {{ upper (required "httpProxy.scheme is required. Supported value is http or https." .Values.httpProxy.scheme) }}
    host: {{ (required "httpProxy.host is required." .Values.httpProxy.host) }}
    port: {{ .Values.httpProxy.port }}
    {{- if .Values.httpProxy.username }}
    username: {{ quote .Values.httpProxy.username }}
    {{- end -}}
    {{- if .Values.httpProxy.password }}
    password: {{ quote .Values.httpProxy.password }}
    {{- end -}}
  {{- end }}
  {{- with .Values.cassandra.restore.enabled }}
  enabledCassandraSchemaSetup: false
  {{- end }}
  config:
    disableUDCA: true
    mintPubSubEnabled: true
    mintDataflowDisabled: true
    mintPubSubTopicName: "apigee-new-mint"
    {{- if .Values.gcp.region }}
    analyticsTracePubSubEndpoint: {{ .Values.gcp.region }}-pubsub.googleapis.com
    {{- else }}
    analyticsTracePubSubEndpoint: pubsub.googleapis.com
    {{- end }}
  components:
    udca: {}
    cassandraUserSetup:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ .Values.apigeeUserID }}
        runAsGroup: {{ .Values.apigeeGroupID }}
        # b/470346620: privileged dropped and locked down to match the
        # sibling cassandraSchemaSetup pod, which runs the same
        # apigee-hybrid-cassandra-client image without privilege. The
        # user-setup workload is a client-side cqlsh bootstrap; it does
        # not require host capabilities, kernel access, or writable
        # rootfs.
        privileged: false
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: ["ALL"]
        {{- if ne $cassandraUserSetupSeccompProfileType "" }}
        seccompProfile:
          type: {{ $cassandraUserSetupSeccompProfileType }}
          {{- if ne $cassandraUserSetupLocalhostProfile "" }}
          localhostProfile: {{ $cassandraUserSetupLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- $ns := merge (dict) (default dict .Values.cassandraUserSetup.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default .Values.tolerations .Values.cassandraUserSetup.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.cassandraUserSetup.annotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      initContainers:
      - name: "{{ $cassandraReadinessName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.cassandra.auth "n" "apigee-hybrid-cassandra-client") }}
        imagePullPolicy: {{ .Values.cassandra.auth.image.pullPolicy }}
      containers:
      - name: "{{ $cassandraUserSetupName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.cassandra.auth "n" "apigee-hybrid-cassandra-client") }}
        imagePullPolicy: {{ .Values.cassandra.auth.image.pullPolicy }}
    cassandraSchemaSetup:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ .Values.apigeeUserID }}
        runAsGroup: {{ .Values.apigeeGroupID }}
        privileged: false
        {{- if ne $cassandraSchemaSetupSeccompProfileType "" }}
        seccompProfile:
          type: {{ $cassandraSchemaSetupSeccompProfileType }}
          {{- if ne $cassandraSchemaSetupLocalhostProfile "" }}
          localhostProfile: {{ $cassandraSchemaSetupLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- $ns := merge (dict) (default dict .Values.cassandraSchemaSetup.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6 }}
      {{- $t := default .Values.tolerations .Values.cassandraSchemaSetup.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.cassandraSchemaSetup.annotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      initContainers:
      - name: "{{ $cassandraUserReadinessName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.cassandra.auth "n" "apigee-hybrid-cassandra-client") }}
        imagePullPolicy: {{ .Values.cassandra.auth.image.pullPolicy }}
      containers:
      - name: "{{ $cassandraSchemaSetupName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ .Values.mart.image.pullPolicy }}
    connectAgent:
      {{- if ne $connectAgentSeccompProfileType "" }}
      securityContext:
        seccompProfile:
          type: {{ $connectAgentSeccompProfileType }}
          {{- if ne $connectAgentLocalhostProfile "" }}
          localhostProfile: {{ $connectAgentLocalhostProfile }}
          {{- end }}
      {{- end }}
      {{- if .Values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{ $connectAgentName }}-{{ $generatedName }}-sa
      {{- else}}
      {{- if .Values.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ .Values.serviceAccountSecretProviderClass }}
      {{- else if .Values.connectAgent.serviceAccountRef }}
      appServiceAccountSecretName: "{{ .Values.connectAgent.serviceAccountRef }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $connectAgentName }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- $ns := merge (dict) (default dict .Values.connectAgent.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default .Values.tolerations .Values.connectAgent.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.connectAgent.podDisruptionBudget }}
      podDisruptionBudget:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if or .Values.connectAgent.serviceAccountPath .Values.connectAgent.annotations .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations}}
      annotations:
        {{- if .Values.connectAgent.serviceAccountPath }}
        {{ $saAnnotation }}: {{ include "tryFileContent.get" (dict "files" $.Files "f" (required "connectAgent.serviceAccountPath is required!!" .Values.connectAgent.serviceAccountPath)) | sha256sum }}
        {{- end -}}
        {{- if .Values.connectAgent.annotations }}
        {{- with .Values.connectAgent.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- end }}
        {{- with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-mart" | nindent 8 }}
        {{- end }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      {{- with .Values.connectAgent.hostNetwork }}
      hostNetwork: {{ . }}
      {{- end }}
      autoScaler:
        minReplicas: {{ .Values.connectAgent.replicaCountMin }}
        maxReplicas: {{ .Values.connectAgent.replicaCountMax }}
        metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              averageUtilization: {{ .Values.connectAgent.targetCPUUtilizationPercentage }}
      {{ with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      initContainers:
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mart" | nindent 8 }}
      {{- end }}
      containers:
      - name: "{{ $connectAgentName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.connectAgent "n" "apigee-connect-agent") }}
        imagePullPolicy: {{ .Values.connectAgent.image.pullPolicy }}
        {{- with .Values.connectAgent.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        env:
        - name: GRPC_GO_LOG_SEVERITY_LEVEL
          value: "{{ .Values.connectAgent.logLevel }}"
        - name: LOG_VERBOSITY_LEVEL
          value: "{{ .Values.connectAgent.logVerbosity }}"
        {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
        volumeMounts:
        {{- if include "fwi.enabled" . }}
        {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" . }}
          readOnly: true
        {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
        {{- if (.Values.customCA).enabled }}
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ .Values.customCA.configMapKey }}
          readOnly: true
        {{- end }}
        {{- end }}
      {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
      volumes:
      {{- if include "fwi.enabled" . }}
      {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
      - name: fwi-token
        projected:
          sources:
            - serviceAccountToken:
                audience: {{ .Values.gcp.federatedWorkloadIdentity.audience | quote }}
                expirationSeconds: {{ .Values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                path: {{ include "fwi.tokenFile" . | quote }}
      {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
      - name: shared-mount
        emptyDir:
          sizeLimit: 5Mi
          # add any supplemental volumes that the customer needs for their own sidecar
      {{- range $idx, $vol := .Values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
      - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-mart" }}
      {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mart" | nindent 8 }}
      {{- end }}
      {{- end }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      - name: custom-ca
        configMap:
          name: {{ .Values.customCA.configMapName }}
          defaultMode: 420
      {{- end }}
      {{- end }}
    cassandraSchemaValidation:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ .Values.apigeeUserID }}
        runAsGroup: {{ .Values.apigeeGroupID }}
        privileged: false
        {{- if ne $cassandraSchemaValidationSeccompProfileType "" }}
        seccompProfile:
          type: {{ $cassandraSchemaValidationSeccompProfileType }}
          {{- if ne $cassandraSchemaValidationLocalhostProfile "" }}
          localhostProfile: {{ $cassandraSchemaValidationLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- $ns := merge (dict) (default dict .Values.cassandraSchemaValidation.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default .Values.tolerations .Values.cassandraSchemaValidation.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.cassandraSchemaValidation.annotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      initContainers:
      - name: "{{ $cassandraUserReadinessName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.cassandra.auth "n" "apigee-hybrid-cassandra-client") }}
        imagePullPolicy: {{ .Values.cassandra.auth.image.pullPolicy }}
      containers:
      - name: "{{ $cassandraSchemaValidationName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ .Values.mart.image.pullPolicy }}
    watcher:
      {{- if ne $watcherSeccompProfileType "" }}
      securityContext:
        seccompProfile:
          type: {{ $watcherSeccompProfileType }}
          {{- if ne $watcherLocalhostProfile "" }}
          localhostProfile: {{ $watcherLocalhostProfile }}
          {{- end }}
      {{- end }}
      {{- if .Values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{ $watcherName }}-{{ $generatedName }}-sa
      {{- else }}
      {{- if .Values.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ .Values.serviceAccountSecretProviderClass }}
      {{- else if .Values.watcher.serviceAccountRef }}
      appServiceAccountSecretName: "{{ .Values.watcher.serviceAccountRef }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $watcherName }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- $ns := merge (dict) (default dict .Values.watcher.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default .Values.tolerations .Values.watcher.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.watcher.podDisruptionBudget }}
      podDisruptionBudget:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if or .Values.watcher.annotations (and (not .Values.gcp.workloadIdentity.enabled) (.Values.watcher.serviceAccountPath)) .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
      annotations:
        {{- if and (not .Values.gcp.workloadIdentity.enabled) (.Values.watcher.serviceAccountPath) }}
        {{ $saAnnotation }}: {{ include "tryFileContent.get" (dict "files" $.Files "f" (required "watcher.serviceAccountPath is required!!" .Values.watcher.serviceAccountPath)) | sha256sum }}
        {{- end }}
        {{- if .Values.watcher.annotations }}
        {{- with .Values.watcher.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- end }}
        {{- with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-watcher" | nindent 8 }}
        {{- end }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      {{- with .Values.watcher.hostNetwork }}
      hostNetwork: {{ . }}
      {{- end }}
      autoScaler:
        minReplicas: {{ .Values.watcher.replicaCountMin }}
        maxReplicas: {{ .Values.watcher.replicaCountMax }}
        metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              averageUtilization: {{ .Values.watcher.targetCPUUtilizationPercentage }}
      {{ with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      initContainers:
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-watcher" | nindent 8 }}
      {{- end }}
      containers:
      - name: "{{ $watcherName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.watcher "n" "apigee-watcher") }}
        imagePullPolicy: {{ .Values.watcher.image.pullPolicy }}
        {{- with .Values.watcher.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        env:
        - name: ENABLE_ROUTE_SHARDING
          value: !!str {{ .Values.watcher.featureGates.shardRoutes }}
        - name: MAX_ROUTES_PER_SHARD
          value: !!str {{ .Values.watcher.featureGates.maxRoutesPerShard }}
        - name: LOG_LEVEL
          value: {{ .Values.watcher.properties.watcherLogLevel }}
        {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
        volumeMounts:
        {{- if include "fwi.enabled" . }}
        {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" . }}
          readOnly: true
        {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
        {{- if (.Values.customCA).enabled }}
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ .Values.customCA.configMapKey }}
          readOnly: true
        {{- end }}
        {{- end }}
      {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
      volumes:
      {{- if include "fwi.enabled" . }}
      {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
      - name: fwi-token
        projected:
          sources:
            - serviceAccountToken:
                audience: {{ .Values.gcp.federatedWorkloadIdentity.audience | quote }}
                expirationSeconds: {{ .Values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                path: {{ include "fwi.tokenFile" . | quote }}
      {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
      - name: shared-mount
        emptyDir:
          sizeLimit: 5Mi
          # add any supplemental volumes that the customer needs for their own sidecar
      {{- range $idx, $vol := .Values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
      - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-watcher" }}
      {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-watcher" | nindent 8 }}
      {{- end }}
      {{- end }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      - name: custom-ca
        configMap:
          name: {{ .Values.customCA.configMapName }}
          defaultMode: 420
      {{- end }}
      {{- end }}
      properties:
        enableIssueScanning: {{ .Values.watcher.args.enableIssueScanning }}
        issueScanInterval: {{ .Values.watcher.args.issueScanInterval }}
        enableBasepathMigration: {{ .Values.watcher.args.enableBasepathMigration }}
        enableLeaderElect: {{ .Values.watcher.args.enableLeaderElect }}
    mart:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ .Values.apigeeUserID }}
        runAsGroup: {{ .Values.apigeeGroupID }}
        privileged: false
        {{- if ne $martSeccompProfileType "" }}
        seccompProfile:
          type: {{ $martSeccompProfileType }}
          {{- if ne $martLocalhostProfile "" }}
          localhostProfile: {{ $martLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- if  .Values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{ $martName }}-{{ $generatedName }}-sa
      {{- else }}
      {{- if .Values.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ .Values.serviceAccountSecretProviderClass }}
      {{- else if .Values.mart.serviceAccountRef }}
      appServiceAccountSecretName: "{{ .Values.mart.serviceAccountRef }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $martName }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- $ns := merge (dict) (default dict .Values.mart.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default .Values.tolerations .Values.mart.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.mart.podDisruptionBudget }}
      podDisruptionBudget:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if or .Values.mart.serviceAccountPath .Values.mart.annotations .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
      annotations:
        {{- if .Values.mart.serviceAccountPath }}
        {{ $saAnnotation }}: {{ include "tryFileContent.get" (dict "files" $.Files "f" (required "mart.serviceAccountPath is required!!" .Values.mart.serviceAccountPath)) | sha256sum }}
        {{- end -}}
        {{- if .Values.mart.annotations }}
        {{- with .Values.mart.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- end }}
        {{- with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-mart" | nindent 8 }}
        {{- end }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      {{- with .Values.mart.hostNetwork }}
      hostNetwork: {{ . }}
      {{- end }}
      autoScaler:
        minReplicas: {{ .Values.mart.replicaCountMin }}
        maxReplicas: {{ .Values.mart.replicaCountMax }}
        metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              averageUtilization: {{ .Values.mart.targetCPUUtilizationPercentage }}
      {{- if or .Values.mart.cwcAppend (and .Values.gcp.federatedWorkloadIdentity .Values.gcp.federatedWorkloadIdentity.enabled) }}
      configOverride:
      {{- range $k, $v := .Values.mart.cwcAppend }}
        "{{ $k }}": "{{ $v }}"
      {{- end }}
      {{- if and .Values.gcp.federatedWorkloadIdentity .Values.gcp.federatedWorkloadIdentity.enabled }}
        "bin_setenv_cprof_agent_profile": ""
      {{- end }}
      {{- end }}
      initContainers:
      - name: {{ $schemaReadinessName }}
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ .Values.mart.image.pullPolicy }}
      {{ with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mart" | nindent 8 }}
      {{- end }}
      containers:
      - name: "{{ $martName }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ .Values.mart.image.pullPolicy }}
        {{- with .Values.mart.livenessProbe }}
        livenessProbe:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with .Values.mart.readinessProbe }}
        readinessProbe:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with .Values.mart.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- if not .Values.encryptionKeySecretProviderClass }}
        env:
        - name: {{ printf "%s_KMS_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" .Values.org)) }}
          valueFrom:
            secretKeyRef:
              {{- if .Values.kmsEncryptionSecret }}
              name: "{{ .Values.kmsEncryptionSecret.name }}"
              key: "{{ .Values.kmsEncryptionSecret.key }}"
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: kmsEncryptionKey
              {{- end }}
        - name: {{ printf "%s_KVM_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" .Values.org)) }}
          valueFrom:
            secretKeyRef:
              {{- if .Values.kvmEncryptionSecret }}
              name: {{ .Values.kvmEncryptionSecret.name }}
              key: {{ .Values.kvmEncryptionSecret.key }}
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: kvmEncryptionKey
              {{- end }}
        {{- end }}
        {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
        volumeMounts:
        {{- if include "fwi.enabled" . }}
        {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" . }}
          readOnly: true
        {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
        {{- if (.Values.customCA).enabled }}
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ .Values.customCA.configMapKey }}
          readOnly: true
        {{- end }}
        {{- end }}
      {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
      volumes:
      {{- if include "fwi.enabled" . }}
      {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
      - name: fwi-token
        projected:
          sources:
            - serviceAccountToken:
                audience: {{ .Values.gcp.federatedWorkloadIdentity.audience | quote }}
                expirationSeconds: {{ .Values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                path: {{ include "fwi.tokenFile" . | quote }}
      {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
      - name: shared-mount
        emptyDir:
          sizeLimit: 5Mi
          # add any supplemental volumes that the customer needs for their own sidecar
      {{- range $idx, $vol := .Values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
      - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-mart" }}
      {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mart" | nindent 8 }}
      {{- end }}
      {{- end }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      - name: custom-ca
        configMap:
          name: {{ .Values.customCA.configMapName }}
          defaultMode: 420
      {{- end }}
      {{- end }}
    mintTaskScheduler:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ .Values.apigeeUserID }}
        runAsGroup: {{ .Values.apigeeGroupID }}
        privileged: false
        {{- if ne $mintSeccompProfileType "" }}
        seccompProfile:
          type: {{ $mintSeccompProfileType }}
          {{- if ne $mintLocalhostProfile "" }}
          localhostProfile: {{ $mintLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- if .Values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{$mintTaskScheduler}}-{{ $generatedName }}-sa
      {{- else }}
      {{- if .Values.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ .Values.serviceAccountSecretProviderClass }}
      {{- else if .Values.mintTaskScheduler.serviceAccountRef }}
      appServiceAccountSecretName: "{{ .Values.mintTaskScheduler.serviceAccountRef }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $mintTaskScheduler }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- $ns := merge (dict) (default dict .Values.mintTaskScheduler.nodeSelector) .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default .Values.tolerations .Values.mintTaskScheduler.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.mintTaskScheduler.podDisruptionBudget }}
      podDisruptionBudget:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if or .Values.mintTaskScheduler.annotations .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
      annotations:
        {{- with .Values.mintTaskScheduler.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-mint-task-scheduler" | nindent 8 }}
        {{- end }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      {{- with .Values.mintTaskScheduler.cwcAppend }}
      configOverride:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
      volumes:
      {{- if include "fwi.enabled" . }}
      {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
      - name: fwi-token
        projected:
          sources:
            - serviceAccountToken:
                audience: {{ .Values.gcp.federatedWorkloadIdentity.audience | quote }}
                expirationSeconds: {{ .Values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                path: {{ include "fwi.tokenFile" . | quote }}
      {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
      - name: shared-mount
        emptyDir:
          sizeLimit: 5Mi
          # add any supplemental volumes that the customer needs for their own sidecar
      {{- range $idx, $vol := .Values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
      - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-mint-task-scheduler" }}
      {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mint-task-scheduler" | nindent 8 }}
      {{- end }}
      {{- end }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      - name: custom-ca
        configMap:
          name: {{ .Values.customCA.configMapName }}
          defaultMode: 420
      {{- end }}
      {{- end }}
      initContainers:
      - name: {{$schemaReadinessName}}
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ .Values.mart.image.pullPolicy }}
      {{ with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mint-task-scheduler" | nindent 8 }}
      {{- end }}
      containers:
      - name: "{{ $mintTaskScheduler }}"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mintTaskScheduler "n" "apigee-mint-task-scheduler") }}
        imagePullPolicy: {{ .Values.mintTaskScheduler.image.pullPolicy }}
        {{- with .Values.mintTaskScheduler.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- if or (include "fwi.enabled" .) ((.Values.customCA).enabled) }}
        volumeMounts:
        {{- if include "fwi.enabled" . }}
        {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" . }}
          readOnly: true
        {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
        {{- if (.Values.customCA).enabled }}
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ .Values.customCA.configMapKey }}
          readOnly: true
        {{- end }}
        {{- end }}
        {{- if not .Values.encryptionKeySecretProviderClass }}
        env:
        - name: {{ printf "%s_KMS_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" .Values.org)) }}
          valueFrom:
            secretKeyRef:
              {{- if .Values.kmsEncryptionSecret }}
              name: "{{ .Values.kmsEncryptionSecret.name }}"
              key: "{{ .Values.kmsEncryptionSecret.key }}"
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: kmsEncryptionKey
              {{- end }}
        {{- end }}
    ingressGateways:
    {{- $version := include "validateVersion" (dict "version" .Chart.AppVersion) | quote -}}
    {{- $apigeeUserID := .Values.apigeeUserID -}}
    {{- $apigeeGroupID := .Values.apigeeGroupID -}}
    {{- $nodeSelector := .Values.nodeSelector -}}
    {{- $tolerations := default .Values.tolerations .Values.apigeeIngressGateway.tolerations -}}
    {{- $affinity := .Values.affinity -}}
    {{- $image := include "container.image" (dict "hub" .Values.hub "o" .Values.apigeeIngressGateway "n" "apigee-asm-ingress") -}}
    {{- $imagePullPolicy := .Values.apigeeIngressGateway.image.pullPolicy -}}
    {{- $watcherImage := include "container.image" (dict "hub" .Values.hub "o" .Values.watcher "n" "apigee-watcher") -}}
    {{- $watcherImagePullPolicy := .Values.watcher.image.pullPolicy -}}
    {{- $replicaCountMin := .Values.apigeeIngressGateway.replicaCountMin -}}
    {{- $replicaCountMax := .Values.apigeeIngressGateway.replicaCountMax -}}
    {{- $terminationGracePeriodSeconds := .Values.apigeeIngressGateway.terminationGracePeriodSeconds -}}
    {{- $ingresstargetCPUUtilization := .Values.apigeeIngressGateway.targetCPUUtilizationPercentage -}}
    {{- $ingressGateways := .Values.ingressGateways -}}
    {{- if and .Values.ingressGateways ( eq (include "appendChainingGateway" .) "true" ) -}}
      {{- $ingressGateways = append $ingressGateways .Values.apigeeChainingGateway -}}
    {{- end -}}
    {{- range $i, $g := $ingressGateways }}
    - name: {{ quote $g.name }}
      version: {{ $version }}
      properties:
        proxyProtocol:
          mode: {{ include "getProxyProtocolMode" (dict "component" $g "values" $.Values) }}
      {{- if or $g.svcAnnotations (or $g.svcloadBalancerIP $g.svcType) }}
      serviceSpec:
        {{- if $g.svcAnnotations }}
        {{- with $g.svcAnnotations }}
        annotations:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- end }}
        {{- if $g.svcLoadBalancerIP }}
        {{- with $g.svcLoadBalancerIP }}
        loadBalancerIP: {{ $g.svcLoadBalancerIP }}
        {{- end }}
        {{- end }}
        {{- if $g.svcType}}
        {{- with $g.svcType }}
        type: {{ $g.svcType }}
        {{- end }}
        {{- end }}
      {{- end}}
      autoScaler:
        minReplicas: {{ default $replicaCountMin $g.replicaCountMin}}
        maxReplicas: {{ default $replicaCountMax $g.replicaCountMax}}
        metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              averageUtilization: {{ default $ingresstargetCPUUtilization  $g.targetCPUUtilizationPercentage }}
      containers:
      - name: "apigee-ingressgateway"
        image: {{ $image }}
        imagePullPolicy: {{ $imagePullPolicy }}
        {{- with $g.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
      - name: "apigee-ingressgateway-config"
        image: {{ $watcherImage }}
        imagePullPolicy: {{ $watcherImagePullPolicy }}
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ $apigeeUserID }}
        runAsGroup: {{ $apigeeGroupID }}
        privileged: false
        {{- if ne $apigeeIngressGatewaySeccompProfileType "" }}
        seccompProfile:
          type: {{ $apigeeIngressGatewaySeccompProfileType }}
          {{- if ne $apigeeIngressGatewayLocalhostProfile "" }}
          localhostProfile: {{ $apigeeIngressGatewayLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- $ns := merge (dict) (default dict $g.nodeSelector) $nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- with $tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- $pdb := default $.Values.apigeeIngressGateway.podDisruptionBudget $g.podDisruptionBudget }}
      {{- with $pdb }}
      podDisruptionBudget:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      terminationGracePeriodSeconds: {{ $terminationGracePeriodSeconds }}
    {{- end }}
    {{- if .Values.enableMcpServer }}
    mcpServers:
    - name: "default"
      version: {{ include "validateVersion" (dict "version" .Chart.AppVersion) | quote }}
      autoScaler:
        minReplicas: {{ .Values.mcpServer.replicaCountMin }}
        maxReplicas: {{ .Values.mcpServer.replicaCountMax }}
        metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              averageUtilization: {{ .Values.mcpServer.targetCPUUtilizationPercentage }}
      {{ with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      initContainers:
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mcp-server" | nindent 8 }}
      {{- end }}
      containers:
      - name: "apigee-mcp-server"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mcpServer "n" "apigee-envoy-dataplane") }}
        {{- with .Values.mcpServer.image.pullPolicy }}
        imagePullPolicy: {{ . }}
        {{- end }}
        {{- with .Values.mcpServer.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- if include "fwi.enabled" . }}
        volumeMounts:
        {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" . }}
          readOnly: true
        {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
      - name: "apigee-mcp-server-config"
        image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.mcpServer.sidecar "n" "apigee-watcher") }}
        {{- with .Values.mcpServer.sidecar.image.pullPolicy }}
        imagePullPolicy: {{ . }}
        {{- end }}
        {{- with .Values.mcpServer.sidecar.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- if include "fwi.enabled" . }}
        volumeMounts:
        {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" . }}
          readOnly: true
        {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
      {{- if include "fwi.enabled" . }}
      volumes:
      {{- if eq .Values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
      - name: fwi-token
        projected:
          sources:
            - serviceAccountToken:
                audience: {{ .Values.gcp.federatedWorkloadIdentity.audience | quote }}
                expirationSeconds: {{ .Values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                path: {{ include "fwi.tokenFile" . | quote }}
      {{- else if eq .Values.gcp.federatedWorkloadIdentity.type "sidecar" }}
      - name: shared-mount
        emptyDir:
          sizeLimit: 5Mi
      {{- range $idx, $vol := .Values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
      - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-mcp-server" }}
      {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-mcp-server" | nindent 8 }}
      {{- end }}
      {{- end }}
      {{- end }}
      properties: {}
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ .Values.apigeeUserID }}
        runAsGroup: {{ .Values.apigeeGroupID }}
        privileged: false
        {{- if ne $mcpServerSeccompProfileType "" }}
        seccompProfile:
          type: {{ $mcpServerSeccompProfileType }}
          {{- if ne $mcpServerLocalhostProfile "" }}
          localhostProfile: {{ $mcpServerLocalhostProfile }}
          {{- end }}
        {{- end }}
      {{- if .Values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{ $mcpServerName }}-{{ $generatedName }}-sa
      {{- else }}
      {{- if .Values.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ .Values.serviceAccountSecretProviderClass }}
      {{- else if .Values.mcpServer.serviceAccountRef }}
      appServiceAccountSecretName: "{{ .Values.mcpServer.serviceAccountRef }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $mcpServerName }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- with .Values.nodeSelector }}
      {{- include "nodeAffinity.runtime" . | nindent 6 }}
      {{- end }}
      {{- $t := default .Values.tolerations .Values.mcpServer.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.mcpServer.podDisruptionBudget }}
      podDisruptionBudget:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- $mcpSAPath := default .Values.watcher.serviceAccountPath .Values.mcpServer.serviceAccountPath }}
      {{- if or .Values.mcpServer.annotations (and (not .Values.gcp.workloadIdentity.enabled) $mcpSAPath) .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
      annotations:
        {{- if and (not .Values.gcp.workloadIdentity.enabled) $mcpSAPath }}
        {{ $saAnnotation }}: {{ include "tryFileContent.get" (dict "files" $.Files "f" (required "mcpServer.serviceAccountPath or watcher.serviceAccountPath is required!!" $mcpSAPath)) | sha256sum }}
        {{- end }}
        {{- if .Values.mcpServer.annotations }}
        {{- with .Values.mcpServer.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- end }}
        {{- with .Values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-mcp-server" | nindent 8 }}
        {{- end }}
      {{- end }}
      terminationGracePeriodSeconds: {{ .Values.mcpServer.terminationGracePeriodSeconds | default 30 }}
    {{- end }}
---



