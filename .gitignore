# values-common.yaml — Apigee Redis — Cluster 1 (ROKS BNP)
# Chemin: values/platform/redis/values-common.yaml
#
# IMPORTANT: Le helper http_proxy.url utilise urlquery pour encoder
# le mot de passe automatiquement. Mettre le mot de passe RAW ici,
# PAS percent-encoded. Exemple: "Zlina2024&201922" (pas "Zlina2024%26201922")

namespace: apigee-ap88257-hprd-dce13121

contractProvider: https://apigee.eu.rep.googleapis.com

apigeeGroupID: 998
apigeeUserID: 999

nodeSelector:
  requiredForScheduling: true
  apigeeRuntime:
    key: "workload"
    value: "apigee-runtime"
  apigeeData:
    key: "workload"
    value: "apigee-data"

imagePullSecrets:
  - name: "image-pull-secret"

httpProxy:
  
# --- Redis ---
redis:
  auth:
    # Option 1 : Laisser le chart creer le Secret automatiquement
    password: "<TON-MOT-DE-PASSE-REDIS>"
    # Option 2 : Secret pre-existant (commenter password ci-dessus et decommenter)
    # secret: "apigee-redis-default-creds"
    # Option 3 : Vault CSI SecretProviderClass
    # secretProviderClass: "vault-redis-spc"
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-redis"
    tag: "1.17.0"
    pullPolicy: Always
  replicaCount: 2
  resources:
    requests:
      cpu: 500m
      memory: 512Mi
    limits:
      cpu: 1000m
      memory: 1Gi
  envoy:
    image:
      url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-envoy"
      tag: "1.17.0"
      pullPolicy: Always
    replicaCountMin: 1
    replicaCountMax: 2
    targetCPUUtilizationPercentage: 75
    resources:
      requests:
        cpu: 500m
        memory: 512Mi
      limits:
        cpu: 2000m
        memory: 2Gi

# --- Guardrails ---
guardrails:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 500m
      memory: 256Mi
  envVars:
    SSL_CERT_FILE: "/etc/ssl/certs/ca-certificates.crt"
    no_proxy: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"
    NO_PROXY: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"

# --- Custom CA (proxy TLS ) ---
customCA:



{{- $seccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.guardrails "values" .Values) | fromYaml -}}
{{- $seccompProfileType := $seccompProfileInfo.type }}
{{- $localhostProfile := $seccompProfileInfo.localhostProfile }}
{{- $httpProxyURL := include "http_proxy.url" . -}}
apiVersion: v1
kind: Pod
metadata:
  name: apigee-hybrid-helm-guardrail-redis
  namespace: {{ include "namespace" . }}
  annotations:
    helm.sh/hook: pre-install,pre-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    {{- with .Values.redis.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
  labels:
    app: apigee-hybrid-helm-guardrail
spec:
  {{- with .Values.imagePullSecrets }}
  imagePullSecrets:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  {{- $ns := merge (dict) (default dict .Values.guardrails.nodeSelector) .Values.nodeSelector }}
  {{- if $ns }}
  affinity:
    {{- include "nodeAffinity.runtime" $ns | nindent 4 }}
  {{- end }}
  {{- $t := default .Values.tolerations .Values.guardrails.tolerations }}
  {{- with $t }}
  tolerations:
    {{- toYaml $t | nindent 4 }}
  {{- end }}
  securityContext:
    runAsNonRoot: true
    runAsUser: {{ .Values.apigeeUserID }}
    runAsGroup: {{ .Values.apigeeGroupID }}
    {{- if ne $seccompProfileType "" }}
    seccompProfile:
      type: {{ $seccompProfileType }}
      {{- if ne $localhostProfile "" }}
      localhostProfile: {{ $localhostProfile }}
      {{- end }}
    {{- end }}
  containers:
    - name: apigee-hybrid-helm-guardrail-container
      image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.guardrails "n" "apigee-watcher") }}
      imagePullPolicy: {{ .Values.guardrails.image.pullPolicy }}
      command: ['/helmguardrails']
      env:
      - name: COMPONENT
        value: "redis"
      - name: CHECKPOINT
      {{- if .Values.checkpoint }}
        value: {{ .Values.checkpoint }}
      {{- else }}
        value: "pre-install"
      {{- end }}
      - name: APIGEE_ENDPOINT
        value: {{ .Values.contractProvider}}
      {{- if $httpProxyURL }}
      - name: http_proxy
        value: {{ $httpProxyURL }}
      - name: https_proxy
        value: {{ $httpProxyURL }}
      {{- end }}
      {{- if .Values.guardrails.envVars }}
      {{- range $key, $value := .Values.guardrails.envVars }}
      {{- if not (and $httpProxyURL (or (eq (upper $key) "HTTP_PROXY") (eq (upper $key) "HTTPS_PROXY"))) }}
      - name: {{ $key }}
        value: {{ $value | quote }}
      {{- end }}
      {{- end }}
      {{- end }}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
          - ALL
      {{- with .Values.guardrails.resources }}
      resources:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      volumeMounts:
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ .Values.customCA.configMapKey }}
          readOnly: true
      {{- end }}
  {{- if (.Values.customCA).enabled }}
  volumes:
    - name: custom-ca
      configMap:
        name: {{ .Values.customCA.configMapName }}
        defaultMode: 420
  {{- end }}
  restartPolicy: Never
  terminationGracePeriodSeconds: 0


# values-common.yaml — Apigee Org — Cluster 1 (ROKS BNP)
# Chemin: values/platform/org/values-common.yaml
#
# IMPORTANT: Le helper http_proxy.url utilise urlquery pour encoder
# le mot de passe automatiquement. Mettre le mot de passe RAW ici,
# PAS percent-encoded. Exemple: "Zlina2024&201922" (pas "Zlina2024%26201922")

namespace: apigee-ap88257-hprd-dce13121

contractProvider: https://apigee.eu.rep.googleapis.com

org: "apigee-ocp-tech"
instanceID: "ops-ap88257-test-cfdeb9ed"

k8sCluster:
  name: "apigee-ap88257-hprd-dce13121"
  region: "europe-west9"

gcp:
  projectID: "apigee-ocp-tech"
  region: "europe-west9"
  workloadIdentity:
    enabled: false
  federatedWorkloadIdentity:
    enabled: false

apigeeGroupID: 998
apigeeUserID: 999

nodeSelector:
  requiredForScheduling: true
  apigeeRuntime:
    key: "workload"
    value: "apigee-runtime"
  apigeeData:
    key: "workload"
    value: "apigee-data"

imagePullSecrets:
  - name: "image-pull-secret"

httpProxy:
 

# --- Images (toutes sur ICR privé BNP) ---
hub: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid"

cassandra:
  auth:
    image:
      url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-hybrid-cassandra-client"
      tag: "1.17.0"
      pullPolicy: Always

# --- Service accounts (clé JSON GCP via Secret Kubernetes) ---
# Tous les composants utilisent le même fichier de clé GCP
connectAgent:
  serviceAccountRef: "apigee-non-prod-svc-account-secret"
  replicaCountMin: 1
  replicaCountMax: 1
  targetCPUUtilizationPercentage: 75
  logLevel: "ERROR"
  logVerbosity: "0"
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-connect-agent"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 200m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi

watcher:
  serviceAccountRef: "apigee-non-prod-svc-account-secret"
  replicaCountMin: 1
  replicaCountMax: 1
  targetCPUUtilizationPercentage: 75
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 200m
      memory: 128Mi
    limits:
      cpu: 1000m
      memory: 2Gi
  args:
    enableIssueScanning: true
    issueScanInterval: 60
    enableBasepathMigration: true
    enableLeaderElect: true
  properties:
    watcherLogLevel: info
  featureGates:
    shardRoutes: true
    maxRoutesPerShard: 1000

mart:
  serviceAccountRef: "apigee-non-prod-svc-account-secret"
  replicaCountMin: 1
  replicaCountMax: 2
  targetCPUUtilizationPercentage: 75
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-mart-server"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 500m
      memory: 512Mi
    limits:
      cpu: 2000m
      memory: 5Gi
  livenessProbe:
    httpGet:
      path: /v1/probes/live
      scheme: HTTPS
      port: 8843
    timeoutSeconds: 1
    failureThreshold: 12
    periodSeconds: 5
    initialDelaySeconds: 30
  readinessProbe:
    httpGet:
      path: /v1/probes/ready
      scheme: HTTPS
      port: 8843
    timeoutSeconds: 1
    successThreshold: 1
    failureThreshold: 2
    periodSeconds: 5
    initialDelaySeconds: 15

mintTaskScheduler:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-mint-task-scheduler"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 500m
      memory: 512Mi
    limits:
      cpu: 2000m
      memory: 4Gi

# --- Ingress Gateways ---
apigeeIngressGateway:
  replicaCountMin: 2
  replicaCountMax: 4
  terminationGracePeriodSeconds: 300
  targetCPUUtilizationPercentage: 75
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-asm-ingress"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    limits:
      cpu: 2000m
      memory: 1Gi
    requests:
      cpu: 300m
      memory: 128Mi

# Au moins un ingressGateway est requis
ingressGateways:
  - name: "apigee-ingress"
    replicaCountMin: 2
    replicaCountMax: 4
    svcType: ClusterIP

# --- Cert Manager ---
ao:
  certManagerCAIssuerEnabled: true

# --- Encryption keys ---
# IMPORTANT: Remplacer ces clés par des clés de production UNIQUES
# Générer: openssl rand -base64 16 (pour kms/kvm), openssl rand -base64 24 (pour contract)
defaults:
  org:
    kmsEncryptionKey: "<CLE_KMS_BASE64>"
    kvmEncryptionKey: "<CLE_KVM_BASE64>"
    contractEncryptionKey: "<CLE_CONTRACT_BASE64>"
    axHashSalt: "<SEL_AX_HASH>"

# --- Guardrails ---
guardrails:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 500m
      memory: 256Mi
  envVars:
    SSL_CERT_FILE: "/etc/ssl/certs/ca-certificates.crt"
    no_proxy: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"
    NO_PROXY: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"

# --- Custom CA (proxy TLS ) ---
customCA:





{{- $seccompProfileInfo := include "getSeccompProfileInfo" (dict "component" .Values.guardrails "values" .Values) | fromYaml }}
{{- $seccompProfileType := $seccompProfileInfo.type }}
{{- $localhostProfile := $seccompProfileInfo.localhostProfile }}
{{- $httpProxyURL := include "http_proxy.url" . -}}
apiVersion: v1
kind: Pod
metadata:
  name: apigee-hybrid-helm-guardrail-org
  namespace: {{ include "namespace" . }}
  annotations:
    helm.sh/hook: pre-install,pre-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    {{- with .Values.watcher.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
