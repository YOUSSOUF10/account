
oc run ca-check --rm -it --restart=Never \
  --image=private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher:1.17.0 \
  --namespace=apigee-ap88257-hprd-dce13121 \
  --command -- sh -c '
    echo "=== OS ===" && cat /etc/os-release 2>/dev/null | head -5;
    echo "=== /etc/ssl/certs/ ===" && ls -la /etc/ssl/certs/ 2>/dev/null | head -20;
    echo "=== /etc/pki/tls/certs/ ===" && ls -la /etc/pki/tls/certs/ 2>/dev/null;
    echo "=== SSL_CERT vars ===" && env | grep -i ssl;
    echo "=== Go crypto check ===" && strings /apigee-watcher 2>/dev/null | grep -i "boring\|x509\|cert" | head -10
  '



oc run ssl-check --rm -it --restart=Never \
  --image=alpine:latest \
  --namespace=apigee-ap88257-hprd-dce13121 \
  --command -- sh -c '
    apk add --no-cache openssl > /dev/null 2>&1;
    echo "=== Cert chain from proxy ===" ;
    echo | openssl s_client -connect 10.254.122.73:3131 \
      -servername apigee.eu.rep.googleapis.com \
      -proxy 10.254.122.73:3131 2>/dev/null | openssl x509 -noout -issuer -subject;
    echo "=== Via CONNECT ===" ;
    echo | openssl s_client -connect apigee.eu.rep.googleapis.com:443 \
      -proxy 10.254.122.73:3131 2>/dev/null | openssl x509 -noout -issuer -subject
  '



oc get configmap npp-ca-bundle -n apigee-ap88257-hprd-dce13121 \
  -o jsonpath='{.data.ca-certificates\.crt}' | openssl x509 -noout -issuer -subject



# Extraire les CA système depuis l'image
oc run extract-ca --rm -it --restart=Never \
  --image=private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher:1.17.0 \
  --namespace=apigee-ap88257-hprd-dce13121 \
  --command -- cat /etc/ssl/certs/ca-certificates.crt > /tmp/system-ca.crt

# Récupérer le cert BNP
oc get configmap npp-ca-bundle -n apigee-ap88257-hprd-dce13121 \
  -o jsonpath='{.data.ca-certificates\.crt}' > /tmp/bnp-ca.crt

# Combiner
cat /tmp/system-ca.crt /tmp/bnp-ca.crt > /tmp/combined-ca.crt

# Créer la nouvelle ConfigMap
oc create configmap npp-ca-bundle-combined \
  --from-file=ca-certificates.crt=/tmp/combined-ca.crt \
  -n apigee-ap88257-hprd-dce13121
