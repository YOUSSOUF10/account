
kubectl get crd -o name | grep apigee | xargs -I{} kubectl get {} -o jsonpath='{.metadata.name}: {.spec.conversion.webhook.clientConfig.service.namespace}{"\n"}'


for crd in $(kubectl get crd -o name | grep apigee); do
  kubectl patch $crd --type=json \
    -p='[{"op":"replace","path":"/spec/conversion/webhook/clientConfig/service/namespace","value":"apigee-ap88257-hprd-dce13121"}]' \
    2>/dev/null && echo "Patched: $crd" || echo "Skipped: $crd (no webhook)"
done




kubectl get crd -o name | grep apigee | while read crd; do
  ns=$(kubectl get $crd -o jsonpath='{.spec.conversion.webhook.clientConfig.service.namespace}' 2>/dev/null)
  echo "$(basename $crd): $ns"
done


for crd in apigeedeployments.apigee.cloud.google.com \
           apigeeenvironments.apigee.cloud.google.com \
           apigeeorganizations.apigee.cloud.google.com \
           apigeeredis.apigee.cloud.google.com \
           apigeetelemetries.apigee.cloud.google.com \
           apigeevalkeys.apigee.cloud.google.com; do
  kubectl patch crd $crd --type=json \
    -p='[{"op":"replace","path":"/spec/conversion/webhook/clientConfig/service/namespace","value":"apigee-ap88257-hprd-dce13121"}]'
  echo "Patched: $crd"
done
