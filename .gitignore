
kubectl get crd -o name | grep apigee | xargs -I{} kubectl get {} -o jsonpath='{.metadata.name}: {.spec.conversion.webhook.clientConfig.service.namespace}{"\n"}'


for crd in $(kubectl get crd -o name | grep apigee); do
  kubectl patch $crd --type=json \
    -p='[{"op":"replace","path":"/spec/conversion/webhook/clientConfig/service/namespace","value":"apigee-ap88257-hprd-dce13121"}]' \
    2>/dev/null && echo "Patched: $crd" || echo "Skipped: $crd (no webhook)"
done
