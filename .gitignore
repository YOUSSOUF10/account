
apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Values.namespace }}
  annotations:
    namespaceoperator./applicative_tier: {{ .Values.annotations.applicative_tier | default "PAD" }}
    namespaceoperator./code_app: {{ .Values.annotations.code_app | default "" }}
    namespaceoperator./environment: {{ .Values.annotations.environment | default "QUAL" }}
    namespaceoperator./middleware: {{ .Values.annotations.middleware | default "OTHER-SOFT" }}
  labels:
    ap43591.bnp/deploy_image_pull_secret: "true"
    ap43591-tooling/deploy--ca-bundle: "true"
    mdm./consumer-business-application-auid: {{ .Values.labels.auid | default "ap88257" }}
    mdm./producer-business-application-auid: {{ .Values.labels.auid | default "ap88257" }}



namespace: apigee--hprd-dce13121

annotations:
  applicative_tier: PAD
  code_app: 
  environment: QUAL
  middleware: OTHER-SOFT

labels:
  auid: 



apiVersion: v2
name: apigee-namespace
description: Cree le namespace Apigee et ses labels
version: 0.1.0
type: application
