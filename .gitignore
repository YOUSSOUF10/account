############################################
# 1. APIs du projet hôte
############################################

resource "google_project_service" "services" {
  for_each = toset([
    "cloudresourcemanager.googleapis.com",
    "iam.googleapis.com",
    "cloudkms.googleapis.com",
    "apigee.googleapis.com",
    "apihub.googleapis.com",
  ])

  project            = var.host_project_id
  service            = each.key
  disable_on_destroy = false
}

############################################
# 2. Service agent API hub
############################################

resource "google_project_service_identity" "apihub" {
  provider = google-beta

  project = var.host_project_id
  service = "apihub.googleapis.com"

  depends_on = [google_project_service.services]
}

resource "google_project_iam_member" "apihub_sa_roles" {
  for_each = toset([
    "roles/apihub.admin",
    "roles/apihub.runtimeProjectServiceAgent",
  ])

  project = var.host_project_id
  role    = each.key
  member  = "serviceAccount:${google_project_service_identity.apihub.email}"
}

############################################
# 3. Accès du service agent API hub à sa clé CMEK
############################################
# Binding au niveau de la clé : elle vit dans le projet shared, pas dans le projet hôte.

resource "google_kms_crypto_key_iam_member" "apihub_cmek" {
  crypto_key_id = local.kms_key_ids["apihub"]
  role          = "roles/cloudkms.cryptoKeyEncrypterDecrypter"
  member        = "serviceAccount:${google_project_service_identity.apihub.email}"
}

resource "time_sleep" "wait_iam" {
  create_duration = "60s"

  depends_on = [
    google_project_iam_member.apihub_sa_roles,
    google_kms_crypto_key_iam_member.apihub_cmek,
  ]
}

############################################
# 4. Enregistrement du host project
############################################

resource "google_apihub_host_project_registration" "this" {
  project                      = var.host_project_id
  location                     = var.location
  host_project_registration_id = var.host_project_id
  gcp_project                  = "projects/${var.host_project_id}"

  # L'org Apigee X doit exister avant (voir apigee.tf)
  depends_on = [google_apigee_organization.this]
}

############################################
# 5. Instance API hub (CMEK)
############################################
# ATTENTION : si la clé est désactivée / indisponible plus de 7 jours,
# toutes les données de l'instance sont supprimées définitivement.

resource "google_apihub_api_hub_instance" "this" {
  project             = var.host_project_id
  location            = var.location
  api_hub_instance_id = var.api_hub_instance_id
  description         = var.description

  config {
    encryption_type = "CMEK"
    cmek_key_name   = local.kms_key_ids["apihub"]
    disable_search  = var.disable_search
    vertex_location = var.disable_search ? null : var.vertex_location
  }

  depends_on = [
    google_apihub_host_project_registration.this,
    time_sleep.wait_iam,
  ]

  lifecycle {
    prevent_destroy = true
  }
}
