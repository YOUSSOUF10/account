
oc run ca-test -n apigee-ap88257-hprd-dce13121 \
  --image=fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher \
  --restart=Never \
  --timeout=120s \
  --overrides='{
    "spec": {
      "imagePullSecrets": [{"name": "image-pull-secret"}],
      "securityContext": {
        "runAsNonRoot": true,
        "seccompProfile": {"type": "RuntimeDefault"}
      },
      "containers": [{
        "name": "ca-test",
        "image": "fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher",
        "command": ["sh", "-c", "cat /etc/ssl/certs/ca-certificates.crt 2>/dev/null | head -5; echo ---SEPARATOR---; ls /etc/ssl/certs/ 2>/dev/null; echo ---SEPARATOR---; wget -O /dev/null --timeout=10 https://apigee.eu.rep.googleapis.com 2>&1 || true; echo ---DONE---; sleep 30"],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "runAsNonRoot": true,
          "capabilities": {"drop": ["ALL"]},
          "seccompProfile": {"type": "RuntimeDefault"}
        }
      }]
    }
  }' \
  -- sh -c "sleep 1"  




