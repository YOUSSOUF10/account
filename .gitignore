############################################
# 1. APIs + service agent API hub (module)
############################################

module "project_services" {
  source = "../modules/project-services"

  project_id = var.host_project_id
  services = [
    "cloudresourcemanager.googleapis.com",
    "iam.googleapis.com",
    "apihub.googleapis.com",
  ]
  service_agent_for = "apihub.googleapis.com"
}

resource "google_project_iam_member" "apihub_sa_roles" {
  for_each = toset([
    "roles/apihub.admin",
    "roles/apihub.runtimeProjectServiceAgent",
  ])

  project = var.host_project_id
  role    = each.key
  member  = module.project_services.service_agent_member
}

############################################
# 2. Accès du service agent API hub à sa clé (projet KMS)
############################################

resource "google_kms_crypto_key_iam_member" "apihub" {
  crypto_key_id = var.cmek_key_id
  role          = "roles/cloudkms.cryptoKeyEncrypterDecrypter"
  member        = module.project_services.service_agent_member
}

############################################
# 3. Instance API hub (CMEK)
############################################
# Host project registration : créé automatiquement par Google avec l'org Apigee
# (erreur 409 si géré ici) -> volontairement hors Terraform.
#
# /!\ La création de l'org Apigee génère une instance API hub par défaut en GMEK.
# Elle doit être déprovisionnée AVANT l'apply de ce bloc (sinon 409),
# cf. https://docs.cloud.google.com/apigee/docs/apihub/deprovision
#
# ATTENTION : clé indisponible > 7 jours = données supprimées définitivement.

resource "google_apihub_api_hub_instance" "this" {
  project             = var.host_project_id
  location            = var.location
  api_hub_instance_id = var.api_hub_instance_id
  description         = var.description

  config {
    encryption_type = "CMEK"
    cmek_key_name   = var.cmek_key_id
    disable_search  = var.disable_search
    vertex_location = var.disable_search ? null : var.vertex_location
  }

  depends_on = [
    google_project_iam_member.apihub_sa_roles,
    google_kms_crypto_key_iam_member.apihub,
  ]

  lifecycle {
    prevent_destroy = true
  }
}
