        "command": ["sh", "-c", "cat /etc/ssl/certs/ca-certificates.crt 2>/dev/null | head -5; echo ---SEP---; ls /etc/ssl/certs/ 2>/dev/null; echo ---SEP---; wget -O /dev/null --timeout=10 https://apigee.eu.rep.googleapis.com 2>&1 || true; echo DONE; sleep 30"],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "runAsNonRoot": true,
