# values-common.yaml — Apigee Telemetry — Cluster 1 (ROKS BNP)
# Chemin: values/platform/telemetry/values-common.yaml

gcp:
  region: europe-west9-a
  projectID: "<TON-GCP-PROJECT-ID>"
  workloadIdentity:
    enabled: false

k8sCluster:
  name: "<NOM-CLUSTER-ENREGISTRE>"
  region: europe-west9-a

org: "<TON-ORG-APIGEE>"
instanceID: "<NOM-CLUSTER-ENREGISTRE>"
validateOrg: false
contractProvider: https://apigee.googleapis.com

ao:
  certManagerCAIssuerEnabled: true

nodeSelector:
  requiredForScheduling: true
  apigeeRuntime:
    key: "workload"
    value: "apigee-runtime"
  apigeeData:
    key: "workload"
    value: "apigee-data"

imagePullSecrets:
  - name: "image-pull-secret"

httpProxy:
  host: "10.254.122.73"
  port: "3131"
  scheme: "HTTP"
  username: ""
  password: "<TON_MDP>"

# --- Metrics ---
metrics:
  enabled: true
  disablePrometheusPipeline: true
  serviceAccountPath: "<ton-sa>.json"
  collector:
    image:
      url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-open-telemetry-collector"
      tag: "1.17.0"
      pullPolicy: Always
    envVars:
      HTTP_PROXY: "http://:<TON_MDP>@10.254.122.73:3131"
      HTTPS_PROXY: "http://:<TON_MDP>@10.254.122.73:3131"
      NO_PROXY: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"
  adapter:
    image:
      url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-prometheus-adapter"
      tag: "1.17.0"
      pullPolicy: Always
  prometheus:
    image:
      url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-prom-prometheus"
      tag: "1.17.0"
      pullPolicy: Always
  sdSidecar:
    image:
      url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-stackdriver-prometheus-sidecar"
      tag: "1.17.0"
      pullPolicy: Always

# --- Logger ---
logger:
  enabled: false
  serviceAccountPath: "<ton-sa>.json"

# --- Autoscaling ---
customAutoscaling:
  enabled: true

# --- Guardrails ---
guardrails:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 500m
      memory: 64Mi
  envVars:
    SSL_CERT_FILE: "/etc/ssl/certs/ca-certificates.crt"
    no_proxy: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"
    NO_PROXY: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"

