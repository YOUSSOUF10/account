{{- $saAnnotation := "apigee.cloud.google.com/sa-config-checksum" -}}
{{- $values := .Values -}}
{{- $chart := .Chart -}}
{{- $files := .Files -}}
{{- $release := .Release -}}
{{- range $i, $env := .Values.envs -}}
{{- if eq $env.name $values.env -}}
{{- $generatedName := include "envScopeEncodedName" (dict "org" $values.org "env" $env.name) -}}
{{- $syncSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" $values.synchronizer "env" $env "values" $values) | fromYaml -}}
{{- $syncSeccompProfileType := $syncSeccompProfileInfo.type -}}
{{- $syncLocalhostProfile := $syncSeccompProfileInfo.localhostProfile -}}
{{- $runtimeSeccompProfileInfo := include "getSeccompProfileInfo" (dict "component" $values.runtime "env" $env "values" $values) | fromYaml -}}
{{- $runtimeSeccompProfileType := $runtimeSeccompProfileInfo.type -}}
{{- $runtimeLocalhostProfile := $runtimeSeccompProfileInfo.localhostProfile -}}
{{- if $values.org -}}
apiVersion: apigee.cloud.google.com/v1alpha2
kind: ApigeeEnvironment
metadata:
  name: {{ $generatedName }}
  namespace: {{ include "namespace"  (dict "release" $release "values" $values) }}
  labels:
    apigee.cloud.google.com/platform: apigee
release:
  forceUpdate: true
spec:
  {{- with $values.imagePullSecrets }}
  imagePullSecrets:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  name: {{ $env.name }}
  organizationRef: {{ include "orgScopeEncodedName" (dict "name" $values.org) }}
  {{- if $env.encryptionKeySecretProviderClass }}
  dataEncryptionSecretProviderClass: {{ $env.encryptionKeySecretProviderClass }}
  {{- end }}
  config:
    disableUDCA: true
    {{- if $values.newDataPipeline.debugSession }}
    tracePubSubEnabled: true
    traceDataflowDisabled: true
    {{- end }}
    {{- if $values.newDataPipeline.analytics }}
    analyticsPubSubEnabled: true
    analyticsDataflowDisabled: true
    {{- end }}
    {{- if $values.gcp.region }}
    analyticsTracePubSubEndpoint: {{ $values.gcp.region }}-pubsub.googleapis.com
    {{- else }}
    analyticsTracePubSubEndpoint: pubsub.googleapis.com
    {{- end }}
  components:
    udca: {}
    synchronizer:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ $values.apigeeUserID }}
        runAsGroup: {{ $values.apigeeGroupID }}
        privileged: false
        {{- if ne $syncSeccompProfileType "" }}
        seccompProfile:
          type: {{ $syncSeccompProfileType }}
          {{- if ne $syncLocalhostProfile "" }}
          localhostProfile: {{ $syncLocalhostProfile }}
          {{- end}}
        {{- end}}
      {{- if $values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{ $synchronizerName }}-{{ $generatedName }}-sa
      {{- else }}
      {{- if $env.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ $env.serviceAccountSecretProviderClass }}
      {{- else if and $env.serviceAccountSecretRefs $env.serviceAccountSecretRefs.synchronizer }}
      appServiceAccountSecretName: "{{ $env.serviceAccountSecretRefs.synchronizer }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $synchronizerName }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- $ns := merge (dict) (default dict $values.synchronizer.nodeSelector) $values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6}}
      {{- $t := default $values.tolerations $values.synchronizer.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- $syncPDB := include "getSynchronizerPodDisruptionBudget" (dict "value" $values.synchronizer.podDisruptionBudget "env" $env) }}
      {{- if $syncPDB }}
      podDisruptionBudget:
        {{- $syncPDB | nindent 8 }}
      {{- end }}
      {{- if or (and $env.serviceAccountPaths $env.serviceAccountPaths.synchronizer) $values.synchronizer.annotations $values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
      annotations:
        {{- if and $env.serviceAccountPaths $env.serviceAccountPaths.synchronizer }}
        {{- $s := include "tryFileContent.get" (dict "files" $files "f" ( required "$env.serviceAccountPaths.synchronizer is required!!" $env.serviceAccountPaths.synchronizer)) }}
        {{ $saAnnotation }}: {{ $s | sha256sum }}
        {{- end -}}
        {{- with $values.synchronizer.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- with $values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-synchronizer" | nindent 8 }}
        {{- end }}
      {{- end }}
      version: {{ include "validateVersion" (dict "version" $chart.AppVersion) | quote }}
      {{- with $values.synchronizer.hostNetwork }}
      hostNetwork: {{ . }}
      {{- end }}
      autoScaler:
        minReplicas: {{ include "getSynchronizerReplicaMin" (dict "value" $values.synchronizer.replicaCountMin  "env" $env) }}
        maxReplicas: {{ include "getSynchronizerReplicaMax" (dict "value" $values.synchronizer.replicaCountMax  "env" $env) }}
        metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              averageUtilization: {{ $values.synchronizer.targetCPUUtilizationPercentage }}
      {{- if $env.PollInterval }}
      properties:
        pollInterval: {{ $env.PollInterval }}
      {{- end }}
      {{- if or $values.httpProxy $values.synchronizer.cwcAppend (and $values.gcp.federatedWorkloadIdentity $values.gcp.federatedWorkloadIdentity.enabled) }}
      configOverride:
      {{- if $values.synchronizer.cwcAppend }}
      {{- range $k, $v := $values.synchronizer.cwcAppend }}
        "{{ $k }}": "{{ $v }}"
      {{- end }}
      {{- end }}
      {{- if and $values.gcp.federatedWorkloadIdentity $values.gcp.federatedWorkloadIdentity.enabled }}
        "bin_setenv_cprof_agent_profile": ""
      {{- end }}
      {{- if $values.httpProxy }}
        "conf_http_client_service_jetty.proxy.enabled": "true"
        "conf_http_client_service_jetty.proxy.host": "{{ $values.httpProxy.host }}"
        {{- if $values.httpProxy.port }}
        "conf_http_client_service_jetty.proxy.port": "{{ $values.httpProxy.port }}"
        {{- end }}
        {{- if $values.httpProxy.username }}
        "conf_http_client_service_jetty.proxy.user": "{{ $values.httpProxy.username }}"
        {{- end }}
        {{- if $values.httpProxy.password }}
        "conf_http_client_service_jetty.proxy.password": "{{ b64enc $values.httpProxy.password }}"
        {{- end }}
      {{- end }}
      {{- end }}
      {{- if include "fwi.enabled" (dict "values" $values) }}
      volumes:
      {{- if eq $values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          projected:
            sources:
              - serviceAccountToken:
                  audience: {{ $values.gcp.federatedWorkloadIdentity.audience }}
                  expirationSeconds: {{ $values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                  path: {{ include "fwi.tokenFile" (dict "values" $values) }}
      {{- else if eq $values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          emptyDir:
            sizeLimit: 5Mi
      # add any supplemental volumes that the customer needs for their own sidecar
        {{- range $idx, $vol := $values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
        - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-synchronizer" }}
        {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-synchronizer" | nindent 10 }}
        {{- end }}
     {{- end }}
     {{- end }}
      {{- /* BEGIN PATCH: customCA volume for synchronizer */ -}}
      {{- if ($values.customCA).enabled }}
      {{- if not (include "fwi.enabled" (dict "values" $values)) }}
      volumes:
      {{- end }}
      - name: custom-ca
        configMap:
          name: {{ $values.customCA.configMapName }}
      {{- end }}
      {{- /* END PATCH */ -}}
      initContainers:
      - name: {{ $schemaReadinessName }}
        image: {{ include "container.image" (dict "hub" $values.hub "o" $values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ $values.mart.image.pullPolicy }}
      {{ with $values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-synchronizer" | nindent 8 }}
      {{- end }}
      containers:
      - name: {{ $synchronizerName }}
        image: {{ include "container.image" (dict "hub" $values.hub "o" $values.synchronizer "n" $synchronizerName) }}
        imagePullPolicy: {{ $values.synchronizer.image.pullPolicy }}
        {{- with $values.synchronizer.livenessProbe }}
        livenessProbe:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with $values.synchronizer.readinessProbe }}
        readinessProbe:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with $values.synchronizer.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- if (include "fwi.enabled" (dict "values" $values)) }}
        volumeMounts:
        {{- if eq $values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
          - name: fwi-token
            mountPath: {{ include "fwi.tokenPath" (dict "values" $values) }}
            readOnly: true
        {{- else if eq $values.gcp.federatedWorkloadIdentity.type "sidecar" }}
          - name: shared-mount
            mountPath: /var/run/service-account
            readOnly: true
        {{- end }}
        {{- end }}
        {{- /* BEGIN PATCH: customCA volumeMount for synchronizer */ -}}
        {{- if ($values.customCA).enabled }}
        {{- if not (include "fwi.enabled" (dict "values" $values)) }}
        volumeMounts:
        {{- end }}
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ $values.customCA.configMapKey }}
          readOnly: true
        {{- end }}
        {{- /* END PATCH */ -}}
    runtime:
      {{- if ne $runtimeSeccompProfileType "" }}
      securityContext:
        seccompProfile:
          type: {{ $runtimeSeccompProfileType }}
          {{- if ne $runtimeLocalhostProfile "" }}
          localhostProfile: {{ $runtimeLocalhostProfile }}
          {{- end}}
      {{- end}}
      {{- if $values.gcp.workloadIdentity.enabled }}
      podServiceAccountName: {{ $runtimeName }}-{{ $generatedName }}-sa
      {{- else }}
      {{- if $env.serviceAccountSecretProviderClass }}
      appServiceAccountSecretProviderClass: {{ $env.serviceAccountSecretProviderClass }}
      {{- else if and $env.serviceAccountSecretRefs $env.serviceAccountSecretRefs.runtime }}
      appServiceAccountSecretName: "{{ $env.serviceAccountSecretRefs.runtime }}"
      {{- else }}
      appServiceAccountSecretName: "{{ $runtimeName }}-{{ $generatedName }}-svc-account"
      {{- end }}
      {{- end }}
      {{- $ns := merge (dict) (default dict $values.runtime.nodeSelector) $values.nodeSelector }}
      {{- include "nodeAffinity.runtime" $ns | nindent 6 }}
      {{- $t := default $values.tolerations $values.runtime.tolerations }}
      {{- with $t }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- $runtimePDB := include "getRuntimePodDisruptionBudget" (dict "value" $values.runtime.podDisruptionBudget "env" $env) }}
      {{- if $runtimePDB }}
      podDisruptionBudget:
        {{- $runtimePDB | nindent 8 }}
      {{- end }}
      {{- if or (and $env.serviceAccountPaths $env.serviceAccountPaths.runtime) $values.runtime.annotations $values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations}}
      annotations:
        {{- if and $env.serviceAccountPaths $env.serviceAccountPaths.runtime }}
        {{- $r := include "tryFileContent.get" (dict "files" $.Files "f" (required "$env.serviceAccountPaths.runtime is required!!" $env.serviceAccountPaths.runtime)) }}
        {{ $saAnnotation }}: {{ $r | sha256sum }}
        {{- end -}}
        {{- if $values.runtime.annotations }}
        {{- with $values.runtime.annotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
        {{- end }}
        {{- with $values.gcp.federatedWorkloadIdentity.sidecarSpec.annotations }}
        {{- toYaml . | replace "APIGEE_COMPONENT" "apigee-runtime" | nindent 8 }}
        {{- end }}
      {{- end}}
      version: {{ include "validateVersion" (dict "version" $chart.AppVersion) | quote }}
      {{- with $values.runtime.hostNetwork }}
      hostNetwork: {{ . }}
      {{- end }}
      {{- $runtimeReleaseStrategy := include "getRuntimeReleaseStrategy" (dict "value" (dig "release" "strategy" "" $values.runtime) "env" $env) }}
      {{- if $runtimeReleaseStrategy }}
      release:
        strategy: {{ $runtimeReleaseStrategy | quote }}
      {{- end }}
      autoScaler:
        minReplicas: {{ include "getRuntimeReplicaMin" (dict "value" $values.runtime.replicaCountMin  "env" $env) }}
        maxReplicas: {{ include "getRuntimeReplicaMax" (dict "value" $values.runtime.replicaCountMax  "env" $env) }}
        behavior:
          scaleDown:
            policies:
            - periodSeconds: {{ $values.runtime.hpaBehavior.scaleDown.percent.periodSeconds }}
              type: Percent
              value: {{ $values.runtime.hpaBehavior.scaleDown.percent.value }}
            - periodSeconds: {{ $values.runtime.hpaBehavior.scaleDown.pods.periodSeconds }}
              type: Pods
              value: {{ $values.runtime.hpaBehavior.scaleDown.pods.value }}
            selectPolicy: {{ $values.runtime.hpaBehavior.scaleDown.selectPolicy }}
            stabilizationWindowSeconds: {{ $values.runtime.hpaBehavior.scaleDown.stabilizationWindowSeconds }}
          scaleUp:
            policies:
            - periodSeconds: {{ $values.runtime.hpaBehavior.scaleUp.percent.periodSeconds }}
              type: Percent
              value: {{ $values.runtime.hpaBehavior.scaleUp.percent.value }}
            - periodSeconds: {{ $values.runtime.hpaBehavior.scaleUp.pods.periodSeconds }}
              type: Pods
              value: {{ $values.runtime.hpaBehavior.scaleUp.pods.value }}
            selectPolicy: {{ $values.runtime.hpaBehavior.scaleUp.selectPolicy }}
            stabilizationWindowSeconds: {{ $values.runtime.hpaBehavior.scaleUp.stabilizationWindowSeconds }}
        metrics:
        - type: Pods
          pods:
            metric:
              name: server_main_task_wait_time
            target:
              averageValue:  {{ $values.runtime.hpaMetrics.serverMainTaskWaitTime }}
              type: AverageValue
        - type: Pods
          pods:
            metric:
              name: server_nio_task_wait_time
            target:
              averageValue: {{ $values.runtime.hpaMetrics.serverNioTaskWaitTime }}
              type: AverageValue
        - type: Resource
          resource:
            name: cpu
            target:
              type: "Utilization"
              {{- $runtimeTargetCPUUtilizationPercentage := $values.runtime.hpaMetrics.targetCPUUtilizationPercentage }}
              {{- if $values.runtime.targetCPUUtilizationPercentage }}
              {{- $runtimeTargetCPUUtilizationPercentage = $values.runtime.targetCPUUtilizationPercentage }}
              {{- end }}
              averageUtilization: {{ default $values.runtime.hpaMetrics.targetCPUUtilizationPercentage $values.runtime.targetCPUUtilizationPercentage }}
      {{- $runtimeEnvCWC := include "getRuntimeEnvCWC" (dict "env" $env "default" $values.runtime.cwcAppend) | fromYaml}}
      {{- if or ($runtimeEnvCWC) (and $values.httpProxy $values.httpProxy.useForRuntimeManagement) ($env.httpProxy) (and $values.gcp.federatedWorkloadIdentity $values.gcp.federatedWorkloadIdentity.enabled) }}
      configOverride:
      {{- range $k, $v := $runtimeEnvCWC }}
        "{{ $k }}": "{{ $v }}"
      {{- end }}
      {{- if and $values.gcp.federatedWorkloadIdentity $values.gcp.federatedWorkloadIdentity.enabled }}
        "bin_setenv_cprof_agent_profile": ""
      {{- end }}
      {{- if and $values.httpProxy $values.httpProxy.useForRuntimeManagement }}
        "conf_http_HTTPClient.managementplane.use.proxy": "true"
        "conf/http.properties+HTTPClient.managementplane.proxy.host": "{{ $values.httpProxy.host }}"
        {{- if $values.httpProxy.scheme }}
        "conf/http.properties+HTTPClient.managementplane.proxy.type": "{{ upper $values.httpProxy.scheme }}"
        {{- else }}
        "conf/http.properties+HTTPClient.managementplane.proxy.type": "HTTP"
        {{- end }}
        {{- if $values.httpProxy.port }}
        "conf/http.properties+HTTPClient.managementplane.proxy.port": "{{ $values.httpProxy.port }}"
        {{- end }}
        {{- if and $values.httpProxy.username $values.httpProxy.password }}
        "conf/http.properties+HTTPClient.managementplane.proxy.user": {{ $values.httpProxy.username }}
        "conf/http.properties+HTTPClient.managementplane.proxy.password": {{ $values.httpProxy.password }}
        {{- end }}
      {{- else if $env.managementCallsSkipProxy }}
        "conf_http_HTTPClient.managementplane.skip.proxy": "true"
      {{- end }}
      {{- if $env.httpProxy }}
        "conf_http_HTTPClient.use.proxy": "true"
        "conf/http.properties+HTTPClient.proxy.host": "{{ $env.httpProxy.host }}"
        {{- if $env.httpProxy.scheme }}
        "conf/http.properties+HTTPClient.proxy.type": "{{ upper $env.httpProxy.scheme }}"
        {{- else }}
        "conf/http.properties+HTTPClient.proxy.type": "HTTP"
        {{- end }}
        {{- if $env.httpProxy.port }}
        "conf/http.properties+HTTPClient.proxy.port": "{{ $env.httpProxy.port }}"
        {{- end }}
        {{- if and $env.httpProxy.username $env.httpProxy.password }}
        "conf/http.properties+HTTPClient.proxy.user": {{ $env.httpProxy.username }}
        "conf/http.properties+HTTPClient.proxy.password": {{ $env.httpProxy.password }}
        {{- end }}
      {{- end }}
      {{- if $env.classificationV2Enabled }}
        "conf_message-processor-communication_classificationV2.enabled": "true"
      {{- end }}
      {{- end }}
      initContainers:
      - name: {{ $schemaReadinessName }}
        image: {{ include "container.image" (dict "hub" $values.hub "o" $values.mart "n" "apigee-mart-server") }}
        imagePullPolicy: {{ $values.mart.image.pullPolicy }}
      - name: {{ $envoyReadinessName }}
        image: {{ include "container.image" (dict "hub" $values.hub "o" $values.runtime "n" "apigee-runtime") }}
        imagePullPolicy: {{ $values.runtime.image.pullPolicy }}
      {{ with $values.gcp.federatedWorkloadIdentity.sidecarSpec.container }}
      - name: customer-fwi-sidecar
      {{- omit . "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-runtime" | nindent 8 }}
      {{- end }}
      containers:
      - name: {{ $runtimeName }}
        image: {{ include "container.image" (dict "hub" $values.hub "o" $values.runtime "n" "apigee-runtime") }}
        imagePullPolicy: {{ $values.runtime.image.pullPolicy }}
        env:
        {{- range $k, $v := $values.runtime.envVars }}
        - name: "{{ $k }}"
          value: "{{ $v }}"
        {{- end }}
        {{- if not $env.encryptionKeySecretProviderClass }}
        - name: {{ printf "%s_KMS_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" $values.org)) }}
          valueFrom:
            secretKeyRef:
              {{- if $values.kmsEncryptionSecret }}
              name: {{ $values.kmsEncryptionSecret.name }}
              key: {{ $values.kmsEncryptionSecret.key }}
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: kmsEncryptionKey
              {{- end }}
        - name: {{ printf "%s_%s_CACHE_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" $values.org)) (include "hyphenToUnderscoreUpper" (dict "s" $env.name)) }}
          valueFrom:
            secretKeyRef:
              {{- if $env.cacheEncryptionSecret }}
              name:  {{ $env.cacheEncryptionSecret.name }}
              key: {{ $env.cacheEncryptionSecret.key }}
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: cacheEncryptionKey
              {{- end }}
        - name: {{ printf "%s_%s_KVM_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" $values.org)) (include "hyphenToUnderscoreUpper" (dict "s" $env.name)) }}
          valueFrom:
            secretKeyRef:
              {{- if $env.kvmEncryptionSecret }}
              name: {{ $env.kvmEncryptionSecret.name }}
              key: {{ $env.kvmEncryptionSecret.key }}
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: envKvmEncryptionKey
              {{- end }}
        - name: {{ printf "%s_KVM_ENCRYPTION_KEY" (include "hyphenToUnderscoreUpper" (dict "s" $values.org)) }}
          valueFrom:
            secretKeyRef:
              {{- if $values.kvmEncryptionSecret }}
              name: {{ $values.kvmEncryptionSecret.name }}
              key: {{ $values.kvmEncryptionSecret.key }}
              {{- else }}
              name: "{{ $generatedName }}-encryption-keys"
              key: kvmEncryptionKey
              {{- end }}
        {{- end }}
        - name: DYNAMIC_TARGET_METRICS_AGG_ENABLED
          value: "{{ $values.runtime.featureGates.aggregatedDynamicTargetMetrics }}"
        {{- with $values.runtime.livenessProbe }}
        livenessProbe:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with $values.runtime.readinessProbe }}
        readinessProbe:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- $resourcesToUse := include "getRuntimeResources" (dict "env" $env "value" $values.runtime.resources) | fromYaml }}
        {{- with $resourcesToUse }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        volumeMounts:
        - name: java-sec-policy-volume
          readOnly: true
          mountPath: {{ $values.runtime.installDir }}/security
        - name: policy-secret-volume
          readOnly: true
          mountPath: {{ $values.runtime.installDir }}/policy-secrets
        {{- if (include "fwi.enabled" (dict "values" $values)) }}
        {{- if eq $values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
        - name: fwi-token
          mountPath: {{ include "fwi.tokenPath" (dict "values" $values) }}
          readOnly: true
        {{- else if eq $values.gcp.federatedWorkloadIdentity.type "sidecar" }}
        - name: shared-mount
          mountPath: /var/run/service-account
          readOnly: true
        {{- end }}
        {{- end }}
        {{- /* BEGIN PATCH: customCA volumeMount for runtime */ -}}
        {{- if ($values.customCA).enabled }}
        - name: custom-ca
          mountPath: /etc/ssl/certs/ca-certificates.crt
          subPath: {{ $values.customCA.configMapKey }}
          readOnly: true
        {{- end }}
        {{- /* END PATCH */ -}}
      volumes:
      - name: java-sec-policy-volume
        secret:
          secretName: "{{ $values.org }}-{{ $env.name }}-java-sec-policy"
          optional: true
      - name: policy-secret-volume
        secret:
          secretName: "{{ $values.org }}-{{ $env.name }}-policy-secret"
          optional: true
      {{- /* BEGIN PATCH: customCA volume for runtime */ -}}
      {{- if ($values.customCA).enabled }}
      - name: custom-ca
        configMap:
          name: {{ $values.customCA.configMapName }}
      {{- end }}
      {{- /* END PATCH */ -}}
      {{- if include "fwi.enabled" (dict "values" $values) }}
      {{- if eq $values.gcp.federatedWorkloadIdentity.type "kubernetes" }}
      - name: fwi-token
        projected:
          sources:
            - serviceAccountToken:
                audience: {{ $values.gcp.federatedWorkloadIdentity.audience }}
                expirationSeconds: {{ $values.gcp.federatedWorkloadIdentity.tokenExpiration }}
                path: {{ include "fwi.tokenFile" (dict "values" $values) }}
      {{- else if eq $values.gcp.federatedWorkloadIdentity.type "sidecar" }}
      - name: shared-mount
        emptyDir:
          sizeLimit: 5Mi
          # add any supplemental volumes that the customer needs for their own sidecar
      {{- range $idx, $vol := $values.gcp.federatedWorkloadIdentity.sidecarSpec.volumes }}
      - name: {{ $vol.name | replace "APIGEE_COMPONENT" "apigee-runtime" }}
      {{- omit $vol "name" | toYaml | replace "APIGEE_COMPONENT" "apigee-runtime" | nindent 8 }}
      {{- end -}}
      {{- end -}}
      {{- end -}}
{{- end -}}
{{- end -}}





