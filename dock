# le mot de passe automatiquement. Mettre le mot de passe RAW ici,
# PAS percent-encoded.

namespace: apigee-ap88257-hprd-dce13121

contractProvider: https://apigee.eu.rep.googleapis.com

org: "apigee-ocp-tech"
env: "test"

k8sCluster:
  name: "apigee-ap88257-hprd-dce13121"
  region: "europe-west9"

gcp:
  projectID: "apigee-ocp-tech"
  region: "europe-west9"
  workloadIdentity:
    enabled: false
  federatedWorkloadIdentity:
    enabled: false

apigeeGroupID: 998
apigeeUserID: 999

nodeSelector:
  requiredForScheduling: true
  apigeeRuntime:
    key: "workload"
    value: "apigee-runtime"
  apigeeData:
    key: "workload"
    value: "apigee-data"

imagePullSecrets:
  - name: "image-pull-secret"

httpProxy:


# --- Images globales ---
hub: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid"

# --- Environnement ---
envs:
  - name: "test"
    serviceAccountSecretRefs:
      synchronizer: "apigee-non-prod-svc-account-secret"
      runtime: "apigee-non-prod-svc-account-secret"

# --- mart (initContainers schema-readiness) ---
mart:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-mart-server"
    tag: "1.17.0"
    pullPolicy: Always

# --- synchronizer ---
synchronizer:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-synchronizer"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: 2000m
      memory: 5Gi

# --- runtime ---
runtime:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-runtime"
    tag: "1.17.0"
    pullPolicy: Always
  resources:
    requests:
      cpu: 500m
      memory: 512Mi
    limits:
      cpu: 4000m
      memory: 6Gi

# --- Encryption keys ---
# Générer: openssl rand -base64 16 (kms/kvm/cache)
defaults:
  org:
    kmsEncryptionKey: "<CLE_KMS_BASE64>"
    kvmEncryptionKey: "<CLE_KVM_BASE64>"
  env:
    kmsEncryptionKey: "<CLE_ENV_KMS_BASE64>"
    kvmEncryptionKey: "<CLE_ENV_KVM_BASE64>"
    cacheEncryptionKey: "<CLE_ENV_CACHE_BASE64>"

# --- Guardrails ---
guardrails:
  image:
    url: "private.fr2.icr.io/ap88257-hprd/apigee-release/hybrid/apigee-watcher"
    tag: "1.17.0"
    pullPolicy: Always
  envVars:
    SSL_CERT_FILE: "/etc/ssl/certs/ca-certificates.crt"
    no_proxy: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"
    NO_PROXY: "198.18.0.1,kubernetes.default.svc,.svc,.cluster.local,localhost,127.0.0.1"

# --- Custom CA (proxy TLS ) ---
customCA:



{{- $values := .Values -}}
{{- $release := .Release -}}
{{- $seccompProfileInfo := include "getGuardrailsSeccompProfileInfo" (dict "values" .Values) | fromYaml }}
{{- $httpProxyURL := include "http_proxy.url" . -}}
apiVersion: v1
kind: Pod
metadata:
  name: apigee-hybrid-helm-guardrail-env-{{ include "suffixName" .}}
  namespace: {{ include "namespace"  (dict "release" $release "values" $values) }}
  annotations:
    helm.sh/hook: pre-install,pre-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    {{- with .Values.runtime.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
  labels:
    app: apigee-hybrid-helm-guardrail
spec:
  {{- with .Values.imagePullSecrets }}
  imagePullSecrets:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  {{- $ns := merge (dict) (default dict .Values.guardrails.nodeSelector) .Values.nodeSelector }}
  {{- if $ns }}
  affinity:
    {{- include "nodeAffinity.runtime" $ns | nindent 4 }}
  {{- end }}
  {{- $t := default .Values.tolerations .Values.guardrails.tolerations }}
  {{- with $t }}
  tolerations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  securityContext:
    runAsNonRoot: true
    runAsUser: {{ .Values.apigeeUserID }}
    runAsGroup: {{ .Values.apigeeGroupID }}
    {{- $seccompProfileType := $seccompProfileInfo.type }}
    {{- if ne $seccompProfileType "" }}
    seccompProfile:
      type: {{ $seccompProfileType }}
      {{- $localhostProfile := $seccompProfileInfo.localhostProfile }}
      {{- if ne $localhostProfile "" }}
      localhostProfile: {{ $localhostProfile }}
      {{- end }}
    {{- end }}
  containers:
    - name: apigee-hybrid-helm-guardrail-container
      image: {{ include "container.image" (dict "hub" .Values.hub "o" .Values.guardrails "n" "apigee-watcher") }}
      imagePullPolicy: {{ .Values.guardrails.image.pullPolicy }}
      command: ['/helmguardrails']
      env:
      - name: COMPONENT
        value: "env"
      - name: CHECKPOINT
      {{- if .Values.checkpoint }}
        value: {{ .Values.checkpoint }}
      {{- else }}
        value: "pre-install"
      {{- end }}
      - name: APIGEE_ENDPOINT
        value: {{ .Values.contractProvider}}
      {{- if $httpProxyURL }}
      - name: http_proxy
        value: {{ $httpProxyURL }}
      - name: https_proxy
        value: {{ $httpProxyURL }}
      {{- end }}
      {{- if .Values.guardrails.envVars }}
      {{- range $key, $value := .Values.guardrails.envVars }}
      {{- if not (and $httpProxyURL (or (eq (upper $key) "HTTP_PROXY") (eq (upper $key) "HTTPS_PROXY"))) }}
      - name: {{ $key }}
        value: {{ $value | quote }}
      {{- end }}
      {{- end }}
      {{- end }}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
          - ALL
      {{- with .Values.guardrails.resources }}
      resources:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if (.Values.customCA).enabled }}
      volumeMounts:
      - name: custom-ca
        mountPath: /etc/ssl/certs/ca-certificates.crt
        subPath: {{ .Values.customCA.configMapKey }}
        readOnly: true
      {{- end }}
  {{- if (.Values.customCA).enabled }}
  volumes:
  - name: custom-ca
    configMap:
      name: {{ .Values.customCA.configMapName }}
  {{- end }}
  restartPolicy: Never
  terminationGracePeriodSeconds: 0



