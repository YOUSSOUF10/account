{{- $runtimeName := "apigee-runtime" -}}
{{- $synchronizerName := "apigee-synchronizer" -}}
{{- $schemaReadinessName := "apigee-cassandra-schema-readiness" -}}
{{- $envoyReadinessName := "apigee-redis-envoy-readiness" -}}
